# Sunucu portu
PORT=3000

# Yönetim paneli şifresi (MUTLAKA değiştir)
ADMIN_PASSWORD=degistir-beni

# Oturum çerezlerini imzalamak için rastgele uzun bir metin
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Veritabanı dosyası
DB_PATH=./data/randevu.db

# --- Netgsm SMS (boş bırakılırsa SMS gönderilmez, sadece loga yazılır) ---
NETGSM_USERCODE=
NETGSM_PASSWORD=
# Netgsm'de onaylı SMS başlığın (ör. HAIRBOSS)
NETGSM_HEADER=

# Yeni randevu gelince sana da SMS gelsin istersen numaranı yaz (5XXXXXXXXX)
OWNER_PHONE=

# SMS'te ve sitede görünen salon adresi / telefon (isteğe bağlı)
SALON_ADDRESS=
SALON_PHONE=
